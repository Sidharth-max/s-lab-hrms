# ---- Required ----
# Postgres connection. With docker compose this is set automatically.
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms
# Random secret, at least 32 characters:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-of-64-chars
# Public address of the website (used for links in the app).
APP_URL=https://hrms.s-lab.dev

# ---- Login OTP by SMS ----
# console = OTP only printed in server logs (testing). msg91 = real SMS (needs DLT template).
SMS_PROVIDER=console
# TESTING ONLY: show the OTP on the login screen. Must be false in real use.
OTP_SHOW_IN_UI=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Face recognition ----
# mock = test mode (tester picks the employee). aws = Amazon Rekognition.
FACE_PROVIDER=mock
FACE_MATCH_THRESHOLD=95
# Liveness check (anti-photo). Needs FACE_PROVIDER=aws and AWS_LIVENESS_ROLE_ARN.
FACE_LIVENESS=false
FACE_LIVENESS_THRESHOLD=80
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LIVENESS_ROLE_ARN=

# ---- Android app download ----
GITHUB_REPO=Sidharth-max/s-lab-hrms
# Optional, raises GitHub API rate limit for the update check.
GITHUB_TOKEN=

# Set to false only when testing over plain http (not through the tunnel).
SECURE_COOKIES=true
